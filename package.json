{
  "name": "@deterministic-code/patch-merger",
  "version": "0.1.0",
  "description": "Standalone patch-merge engine: filename-keyed patch writers that compose codegen target files (package.json, Cargo.toml, Dockerfile, .dockerignore, mod.rs/lib.rs, marked-block sources) from dumb patch data.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deterministic-code/patch-merger.git"
  },
  "main": "./typescript/dist/index.cjs",
  "module": "./typescript/dist/index.js",
  "types": "./typescript/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./typescript/dist/index.d.ts",
      "import": "./typescript/dist/index.js",
      "require": "./typescript/dist/index.cjs"
    },
    "./patch-merger": {
      "types": "./typescript/dist/patch-merger.d.ts",
      "import": "./typescript/dist/patch-merger.js",
      "require": "./typescript/dist/patch-merger.cjs"
    }
  },
  "files": [
    "typescript/dist",
    "typescript/src"
  ],
  "scripts": {
    "build": "vite build --config typescript/vite.config.ts",
    "test": "vitest run --config typescript/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.9"
  }
}
