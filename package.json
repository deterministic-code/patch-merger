{
  "name": "@deterministic-code/patch-merger",
  "version": "0.1.0",
  "description": "Standalone patch-merge engine: LineUpsert, Section, DeepJson, DeepYaml, and DeepXml writers compose codegen target files from dumb { target, content, options } patches.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deterministic-code/patch-merger.git"
  },
  "main": "./typescript/dist/index.cjs",
  "module": "./typescript/dist/index.js",
  "types": "./typescript/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./typescript/dist/index.d.ts",
      "import": "./typescript/dist/index.js",
      "require": "./typescript/dist/index.cjs"
    },
    "./patch-merger": {
      "types": "./typescript/dist/patch-merger.d.ts",
      "import": "./typescript/dist/patch-merger.js",
      "require": "./typescript/dist/patch-merger.cjs"
    }
  },
  "files": [
    "typescript/dist"
  ],
  "scripts": {
    "build": "vite build --config typescript/vite.config.ts",
    "typecheck": "tsc --noEmit -p typescript/tsconfig.json",
    "test": "vitest run --config typescript/vite.config.ts --coverage"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.9"
  }
}
